# ===================================================================
# PushpakClasses Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# DO NOT commit real secrets or production credentials to Git.
# ===================================================================

# Database Configuration (SQL Server 2022)
DB_PASSWORD=YourStrong@Passw0rd!
CONNECTION_STRING=Server=sqlserver,1433;Database=PushpakClassesDb;User Id=sa;Password=YourStrong@Passw0rd!;TrustServerCertificate=True;MultipleActiveResultSets=False;Max Pool Size=1024;Connect Timeout=60;
ConnectionStrings__DefaultConnection=Server=localhost,1433;Database=PushpakClassesDb;User Id=sa;Password=YourStrong@Passw0rd!;TrustServerCertificate=True;MultipleActiveResultSets=True;

# JWT Authentication (HMAC-SHA256, minimum 32 characters)
JWT_SECRET=ReplaceWithYourSuperSecretJwtSigningKey32CharsMin!
JwtSettings__Secret=ReplaceWithYourSuperSecretJwtSigningKey32CharsMin!
JwtSettings__Issuer=PushpakClasses.Api
JwtSettings__Audience=PushpakClasses.Client
JwtSettings__AccessTokenExpirationMinutes=15
JwtSettings__RefreshTokenExpirationDays=7

# Initial Seed Admin Account
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
SeedData__AdminUser__Email=admin@example.com
SeedData__AdminUser__Password=ChangeMe123!
SeedData__AdminUser__FullName=System Administrator
SeedData__AdminUser__PhoneNumber=+15555555555

# User Cleanup CLI Protected Accounts (comma-separated list of emails preserved during cleanup)
CLEANUP_PROTECTED_EMAILS=admin@example.com,candidate@example.com

# Redis Distributed Cache
REDIS_CONNECTION=localhost:6379
RedisSettings__ConnectionString=localhost:6379
RedisSettings__Enabled=true
RedisSettings__DefaultExpirationMinutes=10

# Email Delivery (Logging or Smtp)
EmailSettings__Provider=Logging
EmailSettings__FromEmail=noreply@example.com
EmailSettings__FromName=PushpakClasses
EmailSettings__SmtpHost=smtp.example.com
EmailSettings__SmtpPort=587
EmailSettings__EnableSsl=true
EmailSettings__SmtpUserName=your_smtp_user
EmailSettings__SmtpPassword=your_smtp_password
EmailSettings__AppBaseUrl=http://localhost:4200

# Application URLs & Runtime
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:5139
FRONTEND_PORT=4200
API_PORT=5139
